# Laisser vide en dev : PGlite embarqué (fichiers dans .data/pglite)
# En production (docker-compose) : postgres://sodobat:...@db:5432/sodobat
DATABASE_URL=

# Secret de signature des sessions (obligatoire en production)
AUTH_SECRET=change-me-in-production

# Mot de passe initial des comptes créés par `npm run db:seed`. Laisser vide
# pour qu'il soit tiré au hasard et affiché une fois à la fin du seed.
SEED_PASSWORD=

# Assistant IA (chat) — clé projet key.one (kone_live_…), obligatoire pour
# l'onglet Assistant. Les appels OpenAI passent par le proxy key.one, qui
# suit les dépenses par projet. Les deux URL ont ces valeurs par défaut.
KEYONE_API_KEY=
KEYONE_OPENAI_BASE_URL=https://getkeyone.com/api/proxy/openai/v1
KEYONE_ANTHROPIC_BASE_URL=https://getkeyone.com/api/proxy/anthropic
# Secours sans key.one : clé OpenAI directe (ignorée si KEYONE_API_KEY est définie)
OPENAI_API_KEY=
# Modèle utilisé par l'assistant (défaut : gpt-5-mini)
ASSISTANT_MODEL=
