# Laisser vide en dev : PGlite embarqué (fichiers dans .data/pglite)
# En production (docker-compose) : postgres://sodobat:...@db:5432/sodobat
DATABASE_URL=

# Secret de signature des sessions (obligatoire en production)
AUTH_SECRET=change-me-in-production

# Assistant IA (chat) — clé API OpenAI, obligatoire pour l'onglet Assistant
OPENAI_API_KEY=
# Modèle utilisé par l'assistant (défaut : gpt-5-mini)
ASSISTANT_MODEL=
