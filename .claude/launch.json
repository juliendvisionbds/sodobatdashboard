{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-running",
      "url": "http://localhost:3000"
    },
    {
      "name": "dashboard-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dashboard-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "dashboard-clone",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "PGLITE_DIR=.data/clone",
        "npx",
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
