    "purge:imports": "node --import=tsx scripts/purge-imports.ts",
    "recette": "node --import=tsx scripts/recette.ts",
    "recette:assistant": "node --import=tsx scripts/recette-assistant.ts",
    "recette:tg": "node --import=tsx scripts/recette-tg.ts",
    "recette:daf": "node --import=tsx scripts/recette-daf.ts",
    "recette:mapping": "node --import=tsx scripts/test-rules-lifecycle.ts",
    "test:assistant": "node --env-file=.env.local --import=tsx scripts/test-assistant-live.ts",
